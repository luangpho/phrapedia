{
  "name": "phrapedia",
  "private": true,
  "type": "module",
  "version": "0.1.2",
  "description": "Knowledge base for Thai venerable monks, temples and amulets (Phra Khrueang)",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "start:render": "node scripts/render-start.mjs",
    "generate:tauri": "PHRAPEDIA_TAURI=1 nuxt generate",
    "dev:tauri": "PHRAPEDIA_TAURI=1 nuxt dev --port 1420",
    "tauri": "tauri",
    "tauri:dev": "npm run build && tauri dev",
    "tauri:build": "tauri build --config src-tauri/tauri.bundle.conf.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/mcp-toolkit": "^0.24.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "dompurify": "^3.2.6",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.3",
    "nuxt": "^4.6.4",
    "simple-git": "^4.0.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.151",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.0.0",
    "ai": "^7.0.163",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
