# Copy to .env and fill in. All variables are read server-side only.

# Chat AI (Anthropic). Required when settings.ai.provider = "anthropic".
NUXT_ANTHROPIC_API_KEY=
NUXT_ANTHROPIC_MODEL=claude-sonnet-5-5

# Directories (relative to the project root or absolute)
NUXT_DATA_DIR=data
NUXT_SOURCES_DIR=sources
NUXT_STATE_DIR=.phrapedia

# Gemini CLI used for web research (must be installed: npm i -g @google/gemini-cli)
NUXT_GEMINI_COMMAND=gemini
# GEMINI_API_KEY=   # or log in once with `gemini` (OAuth) on this machine
