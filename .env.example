# Copy to .env and fill in. All variables are read server-side only.

# Chat AI: Claude, run through the Claude Code CLI (`claude -p`). No API key needed — log in once with `claude`.
NUXT_AI_MODEL=claude-sonnet-5-5
NUXT_CLAUDE_COMMAND=claude

# Directories (relative to the project root or absolute)
NUXT_DATA_DIR=data
NUXT_SOURCES_DIR=sources
NUXT_STATE_DIR=.phrapedia

# Google CLI used for web research.
#   antigravity (default): Antigravity CLI `agy` — install: curl -fsSL https://antigravity.google/cli/install.sh | bash
#   gemini-cli: legacy Gemini CLI `gemini` — npm i -g @google/gemini-cli (paid tiers / API key only since June 2026)
NUXT_GEMINI_ENGINE=antigravity
NUXT_GEMINI_COMMAND=agy
# GEMINI_API_KEY=   # headless auth; otherwise sign in once interactively (`agy`, or `gemini`) on this machine.
#                   # For agy with an API key also set modelProvider: "gemini" in ~/.gemini/antigravity-cli/settings.json

# Basic authentication (recommended when the server is reachable from the internet, e.g. Render).
# Both must be set to enable it.
NUXT_BASIC_AUTH_USER=
NUXT_BASIC_AUTH_PASSWORD=
